# Copy to .env (or export these) — never commit real values.
TELEGRAM_BOT_TOKEN=          # from @BotFather (required for the bot)
DATA_DIR=./.data             # where language prefs + anonymous counters are kept
PORT=8080                    # web server port (server.js)

# Optional AI fallback for questions the knowledge base can't answer (off when empty).
# Any OpenAI-compatible API works: OpenAI, Groq, OpenRouter, local Ollama (http://localhost:11434/v1)...
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_DAILY_CAP=200
